hardware "IoT_Gateway" {
    service "incubator" {
        runtime "rabbitmq" {}
        input: "temperature"
        output: "humidity"
        ports = [8080, 8081]
        copy = [
            { from = "./config.json", to = "/config.json"},
            { from = "./Dockerfile", to = "/Dockerfile"},
            { from = "./incubator.py", to = "/app/incubator.py"}
        ]
        config = {
            "temperature": 37.0,
            "humidity": 50.0
        }
        buildCommands = [
            "docker build -t incubator ."
        ]
        executionCommand = "python3 /app/incubator.py"
    }

    service "simulator" {
        runtime "python" {
            version = "3.12"
        }
        input: "humidity"
        output: "temperature"
        volumes = [
            { from = "~/simulator/src", to = "/app/src" },
            { from = "./logs", to = "/var/log/simulator" }
        ]
        executionCommand = "python simulator.py"
    }

    data {
        "temperature" {
            type = "rabbitmq-mqtt"
            broker = "mqtt://broker.hivemq.com"
            topic = "sensor/temperature"
            qos = 1
        }
        "humidity" {
            type = "rabbitmq-amqp"
            exchange = "sensor_data"
            routingKey = "sensor/humidity"
            queue = "humidity_queue"
        }
    }
}
