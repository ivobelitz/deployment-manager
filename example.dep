hardware "IoT_Gateway" {
    service "incubator" {
        runtime "python" {
            version = "3.12"
            packages = [ "numpy", "pandas" ]
        }
        runtime "java" {
            version = "11"
        }
        command = "python3 /app/incubator.py"
        publishes = ["incubator_to_sim"]
        subscribes = ["sim_to_incubator"]
        ports = [8080, 8081]
        copy = [
            { from = "./config.json", to = "/config.json"},
            { from = "./Dockerfile", to = "/Dockerfile"},
            { from = "./incubator.py", to = "/app/incubator.py"}
        ]
        config = {
            "temperature": 37.0,
            "humidity": 50.0
        }
    }

    service "simulator" {
        runtime "python" {
            version = "3.12"
        }
        command = "python simulator.py"
        publishes = ["sim_to_incubator"]
        subscribes = ["incubator_to_sim"]
    }
}